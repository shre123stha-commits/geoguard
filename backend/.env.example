# Supabase (default): Dashboard → Connect → "Session pooler" string, with the driver prefix
# changed to postgresql+psycopg and ?sslmode=require appended. Use the SAME URL for both;
# tests then run in schema TEST_DATABASE_SCHEMA of that database.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_SCHEMA=geoguard_test
# Local PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/geoguard_db
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/geoguard_test
JWT_SECRET=CHANGE_ME   # >=32 random chars, e.g. python -c "import secrets;print(secrets.token_hex(32))"
JWT_EXPIRE_MINUTES=480
DATA_DIR=./data
IMAGERY_PROVIDER=stac_public
STAC_API_URL=
CLOUD_COVER_MAX=30
# Alerts: e-mail via your own Gmail (free). Google Account → Security → 2-Step Verification →
# App passwords → create one for "GeoGuard" and paste the 16 characters as SMTP_PASSWORD.
ALERT_PROVIDER=email
ALERT_RECIPIENTS=shresthaagarwal98@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shresthaagarwal98@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=shresthaagarwal98@gmail.com
TELEGRAM_BOT_TOKEN=            # optional, not used unless ALERT_PROVIDER=telegram
BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
SCHEDULER_ENABLED=true
WORKER_ENABLED=true            # in-process scan worker; set false to run scans elsewhere
WORKER_POLL_SECONDS=3
WORKER_STALE_HOURS=2
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
